* {
    selected-normal-foreground:  rgba ( 211, 198, 170, 100 % );
    foreground:                  rgba ( 211, 198, 170, 100 % );
    normal-foreground:           @foreground;
    alternate-normal-background: rgba ( 52, 63, 68, 0 % );

    red:                         rgba ( 230, 126, 128, 100 % );
    selected-urgent-foreground:  rgba ( 211, 198, 170, 100 % );
    blue:                        rgba ( 127, 187, 179, 100 % );
    urgent-foreground:           rgba ( 230, 126, 128, 100 % );
    alternate-urgent-background: rgba ( 52, 63, 68, 0 % );

    active-foreground:           rgba ( 167, 192, 128, 100 % );
    lightbg:                     rgba ( 61, 72, 77, 100 % );
    selected-active-foreground:  rgba ( 167, 192, 128, 100 % );
    alternate-active-background: rgba ( 52, 63, 68, 0 % );

    background:                  rgba ( 45, 53, 59, 95 % );
    bordercolor:                 rgba ( 127, 187, 179, 100 % );
    alternate-normal-foreground: @foreground;
    normal-background:           rgba ( 45, 53, 59, 0 % );
    lightfg:                     rgba ( 157, 169, 160, 100 % );

    selected-normal-background:  rgba ( 66, 80, 71, 100 % );
    border-color:                @foreground;
    spacing:                     2;

    separatorcolor:              rgba ( 133, 146, 137, 75 % );
    urgent-background:           rgba ( 45, 53, 59, 0 % );
    selected-urgent-background:  rgba ( 81, 64, 69, 100 % );
    alternate-urgent-foreground: @urgent-foreground;

    background-color:            rgba ( 0, 0, 0, 0 % );
    alternate-active-foreground: @active-foreground;
    active-background:           rgba ( 52, 63, 68, 100 % );
    selected-active-background:  rgba ( 66, 80, 71, 100 % );
}

window {
    width: 45%;
    height: 42%;
    background-color: @background;
    border-color: rgba ( 127, 187, 179, 75 % );
    border: 5;
    padding: 10;
}

mainbox {
    border: 0;
    padding: 10px 0px 0px;
}

message {
    border: 2px 0px 0px;
    border-color: @separatorcolor;
    padding: 1px;
}

textbox {
    text-color: @foreground;
}

listview {
    fixed-height: 0;
    border: 5px 0px 0px;
    border-color: @separatorcolor;
    spacing: 2px;
    scrollbar: false;
    padding: 10px 0px 0px;
}

element {
    border: 0;
    padding: 11px;
}

element-text {
    background-color: none;
    text-color: inherit;
    vertical-align: 0.5;
}

element.normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}

element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

element.selected.normal {
    border: 5;
    border-radius: 25px;
    border-color: @separatorcolor;
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}

element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}

element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}

scrollbar {
    margin: 11px;
    border: 3px;
    border-color: @separatorcolor;
    border-radius: 20;
    handle-color: @selected-normal-background;
    handle-width: 7px;
}

mode-switcher {
    border: 3px 0px 0px;
    border-color: @separatorcolor;
}

button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

inputbar {
    spacing: 0;
    text-color: @normal-foreground;
    padding: 1px;
}

case-indicator {
    spacing: 0;
    text-color: @normal-foreground;
}

entry {
    spacing: 0;
    text-color: @normal-foreground;
}

prompt {
    spacing: 0;
    text-color: @normal-foreground;
}

inputbar {
    children: [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

textbox-prompt-colon {
    expand: false;
    str: "==>";
    margin: 0px 0.3em 0em 0em;
    text-color: #A7C080;
}

element-icon {
    size: 3.5ch;
}

configuration {
    modes: "run";
    font: "JetBrainsMono Nerd Font 17";
    show-icons: true;
    drun-display-format: "{icon} {name}";
    display-drun: " 󰣇 Run";

    timeout {
        action: "kb-cancel";
        delay: 0;
    }

    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }
}
